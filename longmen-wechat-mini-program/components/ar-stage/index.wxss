.camera-stage { height: 390rpx; position: relative; overflow: hidden; isolation: isolate; background: #4b4339; border-bottom: 1rpx solid rgba(226,197,143,.38); }
.scene-image { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.scene-wash { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(180deg,rgba(9,15,19,.35),transparent 32%,rgba(9,15,19,.16) 56%,rgba(9,15,19,.78)); }
.scene-topline { position: absolute; top: 20rpx; left: 28rpx; right: 28rpx; display: flex; justify-content: space-between; align-items: center; }
.scene-chip,.location-chip { height: 48rpx; padding: 0 16rpx; border: 1rpx solid rgba(248,236,213,.34); border-radius: 999rpx; background: rgba(12,18,21,.42); color: #fff; display: flex; align-items: center; gap: 10rpx; font-size: 18rpx; line-height: 48rpx; }
.scene-chip { letter-spacing: 1rpx; }
.location-chip { margin: 0; color: #eee6d7; }
.location-chip::after { border: 0; }
.live-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #f0c97f; box-shadow: 0 0 12rpx rgba(240,201,127,.85); }
.scan-reticle { position: absolute; left: 53%; top: 49%; width: 160rpx; height: 160rpx; transform: translate(-50%,-50%); opacity: .8; }
.corner { position: absolute; width: 29rpx; height: 29rpx; border-color: #ead4a5; border-style: solid; border-width: 0; }
.tl { top: 0; left: 0; border-left-width: 3rpx; border-top-width: 3rpx; }
.tr { top: 0; right: 0; border-right-width: 3rpx; border-top-width: 3rpx; }
.bl { bottom: 0; left: 0; border-left-width: 3rpx; border-bottom-width: 3rpx; }
.br { bottom: 0; right: 0; border-right-width: 3rpx; border-bottom-width: 3rpx; }
.scan-line { position: absolute; top: 50%; left: 6rpx; right: 6rpx; height: 2rpx; background: linear-gradient(90deg,transparent,#efd59c,transparent); box-shadow: 0 0 12rpx #e7bc68; animation: sweep 2.8s ease-in-out infinite; }
@keyframes sweep { 0%,100% { transform: translateY(-52rpx); opacity: .25; } 50% { transform: translateY(52rpx); opacity: 1; } }
.floating-relic { position: absolute; left: calc(53% + 82rpx); top: 37%; display: flex; align-items: center; gap: 9rpx; transform: translateY(-50%); animation: float 3.4s ease-in-out infinite; }
.relic-glow { position: absolute; width: 50rpx; height: 50rpx; border-radius: 50%; background: rgba(236,197,120,.58); filter: blur(18rpx); }
.relic-glyph { position: relative; width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; color: #f3d38f; border: 1rpx solid #dfb86e; border-radius: 14rpx 3rpx; background: rgba(39,29,17,.78); font: 700 27rpx system-ui; }
.relic-distance { white-space: nowrap; padding: 7rpx 9rpx; color: #f3e7d0; border: 1rpx solid rgba(243,216,169,.5); background: rgba(13,18,20,.64); border-radius: 4rpx; font-size: 15rpx; }
@keyframes float { 0%,100% { margin-top: 0; } 50% { margin-top: -8rpx; } }
.scene-bottomline { position: absolute; left: 28rpx; right: 28rpx; bottom: 22rpx; display: flex; align-items: end; justify-content: space-between; }
.scene-caption { display: flex; flex-direction: column; min-width: 0; max-width: 70%; }
.scene-location { color: rgba(243,231,210,.88); font-size: 17rpx; text-shadow: 0 2rpx 6rpx #000; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.scene-hint { margin-top: 6rpx; color: #fff; font-size: 20rpx; text-shadow: 0 2rpx 6rpx #000; }
.scan-button { height: 62rpx; margin: 0; padding: 0 22rpx; display: flex; align-items: center; background: rgba(20,27,30,.82); border: 1rpx solid rgba(228,197,137,.8); border-radius: 14rpx; color: #f3d697; font-size: 20rpx; }
.scan-button::after { border: 0; }
.modal-scrim { position: fixed; z-index: 10; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; justify-content: center; background: rgba(3,7,10,.74); }
.scanner-sheet { width: 100%; box-sizing: border-box; padding: 18rpx 30rpx calc(34rpx + env(safe-area-inset-bottom)); background: #17212b; border: 1rpx solid rgba(205,178,125,.24); border-bottom: 0; border-radius: 20rpx 20rpx 0 0; }
.sheet-grab { width: 70rpx; height: 6rpx; margin: 0 auto 25rpx; border-radius: 8rpx; background: rgba(220,203,171,.35); }
.sheet-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.sheet-heading>view { display: flex; flex-direction: column; }
.sheet-eyebrow { color: #ac9875; font-size: 16rpx; letter-spacing: 2rpx; }
.sheet-title { margin-top: 6rpx; color: #f2e8d7; font: 700 34rpx system-ui; }
.close-button { width: 52rpx; height: 52rpx; margin: 0; border: 1rpx solid rgba(213,190,148,.23); border-radius: 50%; background: transparent; color: #d5c8b1; font-size: 34rpx; line-height: 48rpx; }
.close-button::after { border: 0; }
.scanner-feed { position: relative; height: 470rpx; overflow: hidden; background: #403a30; border: 1rpx solid rgba(215,190,141,.27); }
.scanner-image { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.scanner-shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(180deg,rgba(5,9,10,.35),transparent 38%,rgba(5,9,10,.64)); }
.scanner-frame { position: absolute; width: 65%; height: 240rpx; left: 50%; top: 42%; transform: translate(-50%,-50%); }
.scan-target { position: absolute; left: 20rpx; right: 20rpx; bottom: 20rpx; display: flex; flex-direction: column; align-items: center; gap: 9rpx; text-align: center; text-shadow: 0 2rpx 6rpx #000; }
.target-star { color: #e7c989; font-size: 26rpx; }
.scan-aim { color: #f5eddf; font-size: 20rpx; }
.scan-status { color: #b4aa97; font-size: 16rpx; }
.scan-actions { display: grid; grid-template-columns: 1fr 1.2fr; gap: 16rpx; margin-top: 20rpx; }
.button { min-height: 78rpx; margin: 0; padding: 0 22rpx; border-radius: 14rpx; font-weight: 600; font-size: 21rpx; display: flex; align-items: center; justify-content: center; }
.button::after { border: 0; }
.button-primary { color: #211b11; background: linear-gradient(135deg,#e4cb94,#bd9958); }
.button-quiet { color: #d8c7a5; border: 1rpx solid rgba(198,166,107,.33); background: rgba(198,166,107,.07); }
.sheet-footnote { display: block; margin-top: 16rpx; color: #837d72; text-align: center; font-size: 15rpx; line-height: 1.6; }

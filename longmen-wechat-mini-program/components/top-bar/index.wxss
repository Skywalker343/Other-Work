.topbar { height: 122rpx; min-height: 122rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 28rpx; background: linear-gradient(180deg,#101820,#121b24); border-bottom: 1rpx solid rgba(198,166,107,.12); }
.brand { display: flex; align-items: center; gap: 14rpx; min-width: 0; }
.brand-mark { width: 38rpx; height: 38rpx; border: 1rpx solid #c6a66b; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #e3c68a; font-family: system-ui; font-size: 22rpx; box-shadow: inset 0 0 0 4rpx rgba(198,166,107,.09); }
.brand-copy { display: flex; flex-direction: column; min-width: 0; }
.brand-location { color: #a99b84; font-size: 17rpx; letter-spacing: 1rpx; }
.brand-title { color: #f2e9d8; font-family: system-ui; font-weight: 700; font-size: 29rpx; letter-spacing: 4rpx; }
.header-actions { display: flex; align-items: center; gap: 10rpx; }
.language-toggle,.role-badge { margin: 0; line-height: 1; }
.language-toggle { min-width: 68rpx; height: 48rpx; padding: 0 12rpx; border: 1rpx solid rgba(198,166,107,.28); border-radius: 12rpx; background: rgba(198,166,107,.06); color: #e5cd99; font-size: 18rpx; }
.role-badge { max-width: 220rpx; height: 48rpx; display: flex; align-items: center; gap: 8rpx; padding: 0 13rpx; border: 1rpx solid rgba(198,166,107,.23); border-radius: 999rpx; background: rgba(198,166,107,.07); color: #d7c8ad; font-size: 18rpx; }
.role-label { max-width: 165rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.badge-dot { width: 9rpx; height: 9rpx; flex: 0 0 9rpx; border-radius: 50%; background: #e3c68a; box-shadow: 0 0 12rpx rgba(227,198,138,.8); }
.chevron { color: #a5957d; font-size: 24rpx; }
